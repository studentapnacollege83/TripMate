
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>TripMate — Plan Less. Travel More.</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <!-- Navbar -->
  <%- include("../partials/navbar") %>


  <!-- Hero Section -->
  <main class="relative overflow-hidden">

    <!-- Background Glow -->
    <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-indigo-600/20 blur-3xl"></div>

    <div class="pointer-events-none absolute -right-32 top-40 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>


    <section class="relative mx-auto max-w-7xl px-6 pb-24 pt-24 md:pb-32 md:pt-32">

      <!-- Hero Content -->
      <div class="mx-auto max-w-4xl text-center">

        <!-- Badge -->
        <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>

          Your all-in-one travel companion
        </div>


        <!-- Heading -->
        <h1 class="text-5xl font-bold leading-tight tracking-tight sm:text-6xl md:text-7xl">

          Plan less.

          <span class="bg-linear-to-r from-indigo-400 via-violet-400 to-cyan-400 bg-clip-text text-transparent">
            Travel more.
          </span>

        </h1>


        <!-- Description -->
        <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-slate-400 md:text-xl">
          Discover destinations, check the weather, explore places,
          build your itinerary and manage your trip — all in one place.
        </p>


        <!-- Destination Search -->
        <form
          action="/places"
          method="GET"
          class="mx-auto mt-10 max-w-2xl"
        >

          <div class="flex flex-col gap-3 rounded-2xl border border-white/10 bg-white/5 p-3 shadow-2xl backdrop-blur-xl sm:flex-row">

            <!-- Input -->
            <div class="flex flex-1 items-center gap-3 rounded-xl bg-white/5 px-4 py-3">

              <span class="text-lg">
                📍
              </span>

              <input
                type="text"
                name="city"
                placeholder="Where do you want to go?"
                required
                autocomplete="off"
                class="w-full bg-transparent text-white outline-none placeholder:text-slate-500"
              >

            </div>


            <!-- Button -->
            <button
              type="submit"
              class="rounded-xl bg-indigo-500 px-7 py-3 font-semibold transition hover:bg-indigo-400 active:scale-95"
            >
              Explore
            </button>

          </div>

        </form>

      </div>


      <!-- Features -->
      <div class="mt-20 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">


        <!-- Weather -->
        <a
          href="/weather"
          class="group rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-indigo-400/30 hover:bg-white/10"
        >

          <div class="mb-4 text-3xl transition group-hover:scale-110">
            🌦️
          </div>

          <h3 class="font-semibold">
            Live Weather
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-400">
            Check destination weather before you travel.
          </p>

          <div class="mt-4 text-sm font-medium text-indigo-400">
            Check Weather →
          </div>

        </a>


        <!-- Places -->
        <a
          href="/places"
          class="group rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-indigo-400/30 hover:bg-white/10"
        >

          <div class="mb-4 text-3xl transition group-hover:scale-110">
            📍
          </div>

          <h3 class="font-semibold">
            Explore Places
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-400">
            Discover attractions and interesting places.
          </p>

          <div class="mt-4 text-sm font-medium text-indigo-400">
            Explore Places →
          </div>

        </a>


        <!-- Itinerary -->
        <a
          href="/trips/new"
          class="group rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-indigo-400/30 hover:bg-white/10"
        >

          <div class="mb-4 text-3xl transition group-hover:scale-110">
            🗓️
          </div>

          <h3 class="font-semibold">
            Build Itinerary
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-400">
            Organize your entire trip day by day.
          </p>

          <div class="mt-4 text-sm font-medium text-indigo-400">
            Plan Trip →
          </div>

        </a>


        <!-- Budget -->
        <a
          href="/trips"
          class="group rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-indigo-400/30 hover:bg-white/10"
        >

          <div class="mb-4 text-3xl transition group-hover:scale-110">
            💰
          </div>

          <h3 class="font-semibold">
            Plan Your Budget
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-400">
            Keep your travel expenses organized.
          </p>

          <div class="mt-4 text-sm font-medium text-indigo-400">
            Manage Budget →
          </div>

        </a>


      </div>

    </section>

  </main>


  <!-- Footer -->
  <%- include("../partials/footer") %>

</body>
</html>
