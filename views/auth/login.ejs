<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Login — TripMate</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="flex min-h-[calc(100vh-160px)] items-center justify-center px-6 py-16">

    <div class="w-full max-w-md">

      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold">
          Welcome back
        </h1>

        <p class="mt-3 text-slate-400">
          Login to continue planning your trips.
        </p>
      </div>

      <form
        action="/login"
        method="POST"
        class="rounded-2xl border border-white/10 bg-white/5 p-7 shadow-2xl"
      >

        <div class="mb-5">
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Email
          </label>

          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          >
        </div>

        <div class="mb-6">
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Password
          </label>

          <input
            type="password"
            name="password"
            required
            placeholder="Enter your password"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          >
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-indigo-500 px-5 py-3 font-semibold transition hover:bg-indigo-400"
        >
          Login
        </button>

      </form>

      <p class="mt-6 text-center text-sm text-slate-400">
        Don't have an account?
        <a href="/register" class="font-medium text-indigo-400 hover:text-indigo-300">
          Create one
        </a>
      </p>

    </div>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>