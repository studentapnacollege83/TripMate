<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>TripMate — Explore Places</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-7xl px-6 py-16">

    <div class="mx-auto max-w-3xl text-center">

      <p class="text-sm font-medium uppercase tracking-widest text-indigo-400">
        TripMate Places
      </p>

      <h1 class="mt-4 text-4xl font-bold sm:text-5xl">
        Explore places
      </h1>

      <p class="mt-4 text-slate-400">
        Discover attractions and interesting places around your destination.
      </p>

      <form
        action="/places"
        method="GET"
        class="mt-8 flex flex-col gap-3 sm:flex-row"
      >

        <input
          type="text"
          name="city"
          value="<%= result ? result.city : '' %>"
          placeholder="Enter city name..."
          required
          class="flex-1 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
        >

        <button
          type="submit"
          class="rounded-xl bg-indigo-500 px-6 py-3 font-semibold transition hover:bg-indigo-400"
        >
          Explore
        </button>

      </form>

    </div>


    <% if (error) { %>

      <div class="mx-auto mt-10 max-w-2xl rounded-2xl border border-red-400/20 bg-red-400/10 p-5 text-center text-red-300">
        <%= error %>
      </div>

    <% } %>


    <% if (result && result.places && result.places.length > 0) { %>

      <div class="mt-14">

        <div class="mb-6">
          <h2 class="text-2xl font-bold">
            Places in <%= result.city %>
          </h2>

          <p class="mt-1 text-slate-400">
            Discover interesting places around your destination.
          </p>
        </div>


        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

          <% result.places.forEach((place) => { %>

            <%
              const placeName =
                place.properties?.name || "Interesting Place";

              const category =
                (place.properties?.kinds || "")
                  .split(",")[0]
                  .replaceAll("_", " ")
                  .replace(/\b\w/g, (letter) => letter.toUpperCase());

              const image = place.image || null;
            %>


            <div class="group overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:bg-white/10">

              <% if (image) { %>

                <div class="h-52 overflow-hidden bg-slate-900">
                  <img
                    src="<%= image %>"
                    alt="<%= placeName %>"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                  >
                </div>

              <% } else { %>

                <div class="flex h-52 items-center justify-center bg-linear-to-br from-indigo-500/20 to-cyan-500/10 text-5xl">
                  📍
                </div>

              <% } %>


              <div class="p-6">

                <h3 class="line-clamp-2 text-lg font-semibold">
                  <%= placeName %>
                </h3>


                <% if (category) { %>

                  <span class="mt-3 inline-block max-w-full rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-medium capitalize text-indigo-300">
                    <%= category %>
                  </span>

                <% } %>


                <% if (place.properties?.xid) { %>

                  <a
  href="/places/<%= place.properties.xid %>?city=<%= encodeURIComponent(result.city) %>"
  class="mt-5 inline-block rounded-xl bg-indigo-500 px-4 py-2 text-sm font-semibold transition hover:bg-indigo-400"
>
  View Details →
</a>

                <% } %>

              </div>

            </div>

          <% }) %>

        </div>

      </div>


    <% } else if (result) { %>

      <div class="mx-auto mt-12 max-w-2xl rounded-2xl border border-white/10 bg-white/5 p-8 text-center">

        <div class="text-4xl">
          📍
        </div>

        <h2 class="mt-4 text-xl font-semibold">
          No places found
        </h2>

        <p class="mt-2 text-slate-400">
          Try searching for another destination.
        </p>

      </div>

    <% } %>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>