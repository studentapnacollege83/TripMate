<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>TripMate — Place Details</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-5xl px-6 py-16">

    <% if (place) { %>

      <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/5 backdrop-blur-xl">

        <div class="bg-linear-to-br from-indigo-500/20 via-violet-500/10 to-cyan-500/10 p-10">

          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500/20 text-3xl">
            📍
          </div>

          <p class="mt-6 text-sm font-medium uppercase tracking-widest text-indigo-400">
            Place Details
          </p>

          <h1 class="mt-3 text-4xl font-bold sm:text-5xl">
            <%= place.name || "Interesting Place" %>
          </h1>

          <% if (place.kinds) { %>
            <p class="mt-4 text-slate-400">
              <%= place.kinds %>
            </p>
          <% } %>

        </div>


        <div class="grid gap-5 p-8 sm:grid-cols-2">

          <% if (place.description) { %>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:col-span-2">

              <h2 class="text-lg font-semibold">
                About this place
              </h2>

              <p class="mt-3 leading-7 text-slate-400">
                <%= place.description %>
              </p>

            </div>

          <% } %>


          <% if (place.address) { %>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">

              <p class="text-sm text-slate-500">
                Address
              </p>

              <p class="mt-2 font-medium">
                <%= place.address %>
              </p>

            </div>

          <% } %>


          <% if (place.latitude && place.longitude) { %>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">

              <p class="text-sm text-slate-500">
                Location
              </p>

              <p class="mt-2 font-medium">
                <%= place.latitude %>, <%= place.longitude %>
              </p>

            </div>

          <% } %>

        </div>


        <div class="flex flex-col gap-3 border-t border-white/10 p-8 sm:flex-row">

          <a
  href="/places?city=<%= encodeURIComponent(city || '') %>"
  class="rounded-xl border border-white/10 px-6 py-3 text-center font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
>
  ← Back to Places
</a>
        </div>

      </div>

    <% } else { %>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-10 text-center">

        <div class="text-5xl">
          📍
        </div>

        <h1 class="mt-5 text-2xl font-bold">
          Place not found
        </h1>

        <p class="mt-2 text-slate-400">
          We couldn't find details for this place.
        </p>

        <a
          href="/places"
          class="mt-6 inline-block rounded-xl bg-indigo-500 px-6 py-3 font-semibold transition hover:bg-indigo-400"
        >
          Explore Places
        </a>

      </div>

    <% } %>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>