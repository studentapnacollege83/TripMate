<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Trips — TripMate</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-7xl px-6 py-16">

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">

      <div>
        <p class="text-sm font-medium text-indigo-400">
          Your travel plans
        </p>

        <h1 class="mt-2 text-3xl font-bold">
          My Trips
        </h1>

        <p class="mt-2 text-slate-400">
          Manage all your planned adventures in one place.
        </p>
      </div>

      <a
        href="/trips/new"
        class="inline-flex rounded-xl bg-indigo-500 px-5 py-3 text-sm font-semibold transition hover:bg-indigo-400"
      >
        + New Trip
      </a>

    </div>

    <% if (trips.length === 0) { %>

      <div class="mt-12 rounded-2xl border border-dashed border-white/10 bg-white/5 p-12 text-center">

        <div class="text-5xl">✈️</div>

        <h2 class="mt-5 text-xl font-semibold">
          No trips yet
        </h2>

        <p class="mx-auto mt-2 max-w-md text-slate-400">
          Start planning your next adventure by creating your first trip.
        </p>

        <a
          href="/trips/new"
          class="mt-6 inline-flex rounded-xl bg-indigo-500 px-5 py-3 text-sm font-semibold hover:bg-indigo-400"
        >
          Create Your First Trip
        </a>

      </div>

    <% } else { %>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">

        <% trips.forEach((trip) => { %>

          <div class="rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10">

            <div class="flex items-start justify-between gap-4">

              <div>
                <h2 class="text-xl font-semibold">
                  <%= trip.title %>
                </h2>

                <p class="mt-2 text-sm text-indigo-400">
                  📍 <%= trip.destination %>
                </p>
                <a
                 href="/trips/<%= trip._id %>"
                 class="mt-5 inline-flex rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
                >
                View Trip
                </a>
              </div>

              <span class="text-2xl">🗺️</span>

            </div>

            <div class="mt-6 space-y-2 text-sm text-slate-400">

              <p>
                📅
                <%= trip.startDate.toLocaleDateString() %>
                —
                <%= trip.endDate.toLocaleDateString() %>
              </p>

              <p>
                💰 Budget:
                ₹<%= trip.budget.toLocaleString("en-IN") %>
              </p>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>