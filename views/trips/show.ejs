
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= trip.title %> — TripMate</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-4xl px-6 py-16">

    <!-- Trip Header -->
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">

      <div>
        <p class="text-sm font-medium text-indigo-400">
          Trip Details
        </p>

        <h1 class="mt-2 text-4xl font-bold">
          <%= trip.title %>
        </h1>

        <p class="mt-3 text-lg text-slate-400">
          📍 <%= trip.destination %>
        </p>
      </div>

      <div class="flex gap-3">

        <a
          href="/trips/<%= trip._id %>/edit"
          class="rounded-xl border border-white/10 px-4 py-2 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white"
        >
          Edit
        </a>

        <form
          action="/trips/<%= trip._id %>/delete"
          method="POST"
          onsubmit="return confirm('Are you sure you want to delete this trip?')"
        >
          <button
            type="submit"
            class="rounded-xl bg-red-500/10 px-4 py-2 text-sm font-medium text-red-400 hover:bg-red-500/20"
          >
            Delete
          </button>
        </form>

      </div>

    </div>


    <!-- Trip Information -->
    <div class="mt-10 grid gap-5 sm:grid-cols-2">

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <p class="text-sm text-slate-500">Start Date</p>
        <p class="mt-2 font-medium">
          <%= trip.startDate.toLocaleDateString() %>
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <p class="text-sm text-slate-500">End Date</p>
        <p class="mt-2 font-medium">
          <%= trip.endDate.toLocaleDateString() %>
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <p class="text-sm text-slate-500">Budget</p>
        <p class="mt-2 font-medium">
          ₹<%= trip.budget.toLocaleString("en-IN") %>
        </p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <p class="text-sm text-slate-500">Created</p>
        <p class="mt-2 font-medium">
          <%= trip.createdAt.toLocaleDateString() %>
        </p>
      </div>

    </div>


    <!-- Notes -->
    <% if (trip.notes) { %>

      <div class="mt-5 rounded-2xl border border-white/10 bg-white/5 p-6">

        <p class="text-sm text-slate-500">
          Notes
        </p>

        <p class="mt-3 whitespace-pre-line leading-7 text-slate-300">
          <%= trip.notes %>
        </p>

      </div>

    <% } %>


    <!-- ==================== BUDGET ==================== -->
    <section class="mt-12">

      <div>
        <p class="text-sm font-medium text-emerald-400">
          Travel Finance
        </p>

        <h2 class="mt-1 text-3xl font-bold">
          Budget Planner
        </h2>

        <p class="mt-2 text-slate-400">
          Track your spending and stay within your trip budget.
        </p>
      </div>


      <%
        const totalSpent = (trip.expenses || []).reduce(
          (total, expense) => total + Number(expense.amount || 0),
          0
        );

        const remainingBudget = Number(trip.budget || 0) - totalSpent;

        const categoryTotals = {
          Stay: 0,
          Food: 0,
          Transport: 0,
          Activities: 0,
          Shopping: 0,
          Other: 0
        };

        (trip.expenses || []).forEach(expense => {
          if (categoryTotals[expense.category] !== undefined) {
            categoryTotals[expense.category] += Number(expense.amount || 0);
          }
        });
      %>


      <!-- Budget Summary -->
      <div class="mt-6 grid gap-5 sm:grid-cols-3">

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-sm text-slate-500">
            Total Budget
          </p>

          <p class="mt-2 text-2xl font-bold">
            ₹<%= Number(trip.budget || 0).toLocaleString("en-IN") %>
          </p>
        </div>


        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="text-sm text-slate-500">
            Total Spent
          </p>

          <p class="mt-2 text-2xl font-bold text-orange-400">
            ₹<%= totalSpent.toLocaleString("en-IN") %>
          </p>
        </div>


        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">

          <p class="text-sm text-slate-500">
            Remaining
          </p>

          <p class="mt-2 text-2xl font-bold <%= remainingBudget < 0 ? 'text-red-400' : 'text-emerald-400' %>">
            ₹<%= remainingBudget.toLocaleString("en-IN") %>
          </p>

        </div>

      </div>


      <!-- Add Expense -->
      <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-6">

        <h3 class="text-lg font-semibold">
          + Add Expense
        </h3>

        <form
          action="/trips/<%= trip._id %>/expenses"
          method="POST"
          class="mt-5 space-y-5"
        >

          <div class="grid gap-5 sm:grid-cols-2">

            <!-- Category -->
            <div>

              <label class="text-sm text-slate-400">
                Category
              </label>

              <select
                name="category"
                required
                class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-emerald-500"
              >
                <option value="">Select category</option>
                <option value="Stay">Stay</option>
                <option value="Food">Food</option>
                <option value="Transport">Transport</option>
                <option value="Activities">Activities</option>
                <option value="Shopping">Shopping</option>
                <option value="Other">Other</option>
              </select>

            </div>


            <!-- Amount -->
            <div>

              <label class="text-sm text-slate-400">
                Amount
              </label>

              <input
                type="number"
                name="amount"
                min="1"
                step="0.01"
                required
                placeholder="2500"
                class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-emerald-500"
              >

            </div>

          </div>


          <!-- Description -->
          <div>

            <label class="text-sm text-slate-400">
              Description
            </label>

            <input
              type="text"
              name="description"
              maxlength="200"
              placeholder="Hotel booking"
              class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-emerald-500"
            >

          </div>


          <!-- Date -->
          <div>

            <label class="text-sm text-slate-400">
              Date
            </label>

            <input
              type="date"
              name="date"
              class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-emerald-500"
            >

          </div>


          <button
            type="submit"
            class="rounded-xl bg-emerald-500 px-5 py-3 font-semibold text-slate-950 transition hover:bg-emerald-400"
          >
            Add Expense
          </button>

        </form>

      </div>


      <!-- Category Summary -->
      <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-6">

        <h3 class="text-lg font-semibold">
          Spending by Category
        </h3>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">

          <% Object.entries(categoryTotals).forEach(([category, amount]) => { %>

            <div class="flex items-center justify-between rounded-xl bg-slate-900/70 px-4 py-3">

              <span class="text-sm text-slate-300">
                <%= category %>
              </span>

              <span class="font-medium">
                ₹<%= amount.toLocaleString("en-IN") %>
              </span>

            </div>

          <% }) %>

        </div>

      </div>


      <!-- Expense List -->
      <% if (trip.expenses && trip.expenses.length > 0) { %>

        <div class="mt-6">

          <h3 class="text-lg font-semibold">
            Recent Expenses
          </h3>

          <div class="mt-4 space-y-3">

            <% trip.expenses.slice().reverse().forEach(expense => { %>

              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">

                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">

                  <div>

                    <div class="flex flex-wrap items-center gap-3">

                      <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400">
                        <%= expense.category %>
                      </span>

                      <span class="text-sm text-slate-500">
                        <%= expense.date ? new Date(expense.date).toLocaleDateString() : "" %>
                      </span>

                    </div>

                    <% if (expense.description) { %>

                      <p class="mt-2 font-medium">
                        <%= expense.description %>
                      </p>

                    <% } %>

                  </div>


                  <div class="flex items-center justify-between gap-4 sm:justify-end">

                    <span class="text-lg font-bold">
                      ₹<%= Number(expense.amount).toLocaleString("en-IN") %>
                    </span>

                    <form
                      action="/trips/<%= trip._id %>/expenses/<%= expense._id %>/delete"
                      method="POST"
                      onsubmit="return confirm('Delete this expense?')"
                    >

                      <button
                        type="submit"
                        class="rounded-lg px-3 py-2 text-sm text-red-400 hover:bg-red-500/10"
                      >
                        Delete
                      </button>

                    </form>

                  </div>

                </div>

              </div>

            <% }) %>

          </div>

        </div>

      <% } else { %>

        <div class="mt-6 rounded-2xl border border-dashed border-white/10 bg-white/5 p-10 text-center">

          <p class="text-lg font-medium text-slate-300">
            No expenses yet
          </p>

          <p class="mt-2 text-sm text-slate-500">
            Add your first expense above to start tracking your budget.
          </p>

        </div>

      <% } %>

    </section>


    <!-- ==================== ITINERARY ==================== -->
    <section class="mt-14">

      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">

        <div>

          <p class="text-sm font-medium text-indigo-400">
            Your Journey
          </p>

          <h2 class="mt-1 text-3xl font-bold">
            Itinerary
          </h2>

          <p class="mt-2 text-slate-400">
            Plan your activities day by day.
          </p>

        </div>

      </div>


      <!-- Add Itinerary Form -->
      <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-6">

        <h3 class="text-lg font-semibold">
          + Add Activity
        </h3>

        <form
          action="/trips/<%= trip._id %>/itinerary"
          method="POST"
          class="mt-5 space-y-5"
        >

          <div class="grid gap-5 sm:grid-cols-2">

            <div>

              <label class="text-sm text-slate-400">
                Day
              </label>

              <input
                type="number"
                name="day"
                min="1"
                required
                placeholder="1"
                class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-indigo-500"
              >

            </div>


            <div>

              <label class="text-sm text-slate-400">
                Time
              </label>

              <select
                name="time"
                required
                class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-indigo-500"
              >
                <option value="">Select time</option>
                <option value="Morning">Morning</option>
                <option value="Afternoon">Afternoon</option>
                <option value="Evening">Evening</option>
              </select>

            </div>

          </div>


          <div>

            <label class="text-sm text-slate-400">
              Activity
            </label>

            <input
              type="text"
              name="activity"
              maxlength="200"
              required
              placeholder="Visit Burj Khalifa"
              class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-indigo-500"
            >

          </div>


          <div>

            <label class="text-sm text-slate-400">
              Location
            </label>

            <input
              type="text"
              name="location"
              maxlength="200"
              placeholder="Downtown Dubai"
              class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-indigo-500"
            >

          </div>


          <div>

            <label class="text-sm text-slate-400">
              Notes
            </label>

            <textarea
              name="notes"
              rows="3"
              maxlength="500"
              placeholder="Any extra details..."
              class="mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 text-white outline-none focus:border-indigo-500"
            ></textarea>

          </div>


          <button
            type="submit"
            class="rounded-xl bg-indigo-500 px-5 py-3 font-semibold transition hover:bg-indigo-400"
          >
            Add to Itinerary
          </button>

        </form>

      </div>


      <!-- Itinerary List -->
      <% if (trip.itinerary && trip.itinerary.length > 0) { %>

        <div class="mt-8 space-y-6">

          <%
            const days = [...new Set(
              trip.itinerary
                .map(item => item.day)
                .sort((a, b) => a - b)
            )];
          %>

          <% days.forEach(day => { %>

            <div class="rounded-2xl border border-white/10 bg-white/5 p-6">

              <h3 class="text-xl font-bold">
                Day <%= day %>
              </h3>


              <div class="mt-5 space-y-4">

                <% trip.itinerary
                  .filter(item => item.day === day)
                  .forEach(item => { %>

                  <div class="rounded-xl border border-white/10 bg-slate-900/70 p-5">

                    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">

                      <div class="flex-1">

                        <span class="inline-block rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-400">
                          <%= item.time %>
                        </span>

                        <h4 class="mt-3 text-lg font-semibold">
                          <%= item.activity %>
                        </h4>

                        <% if (item.location) { %>

                          <p class="mt-2 text-sm text-slate-400">
                            📍 <%= item.location %>
                          </p>

                        <% } %>

                        <% if (item.notes) { %>

                          <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
                            <%= item.notes %>
                          </p>

                        <% } %>

                      </div>


                      <form
                        action="/trips/<%= trip._id %>/itinerary/<%= item._id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Delete this itinerary item?')"
                      >

                        <button
                          type="submit"
                          class="rounded-lg px-3 py-2 text-sm text-red-400 hover:bg-red-500/10"
                        >
                          Delete
                        </button>

                      </form>

                    </div>

                  </div>

                <% }) %>

              </div>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="mt-8 rounded-2xl border border-dashed border-white/10 bg-white/5 p-10 text-center">

          <p class="text-lg font-medium text-slate-300">
            No itinerary yet
          </p>

          <p class="mt-2 text-sm text-slate-500">
            Add your first activity above and start planning your journey.
          </p>

        </div>

      <% } %>

    </section>


    <!-- Back -->
    <a
      href="/trips"
      class="mt-10 inline-flex text-sm text-indigo-400 hover:text-indigo-300"
    >
      ← Back to My Trips
    </a>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>
