<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>New Trip — TripMate</title>

  <link rel="stylesheet" href="/output.css">
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include("../partials/navbar") %>

  <main class="mx-auto max-w-3xl px-6 py-16">

    <div class="mb-8">
      <h1 class="text-3xl font-bold">
        Plan a new trip
      </h1>

      <p class="mt-2 text-slate-400">
        Add the basic details of your upcoming adventure.
      </p>
    </div>

    <form
      action="/trips"
      method="POST"
      class="rounded-2xl border border-white/10 bg-white/5 p-7"
    >

      <div class="grid gap-5 md:grid-cols-2">

        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Trip Title
          </label>

          <input
            type="text"
            name="title"
            required
            maxlength="100"
            placeholder="My Jaipur Weekend"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          >
        </div>

        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Destination
          </label>

          <input
            type="text"
            name="destination"
            required
            maxlength="100"
            placeholder="Jaipur, Rajasthan"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          >
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Start Date
          </label>

          <input
            type="date"
            name="startDate"
            required
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none focus:border-indigo-400"
          >
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-slate-300">
            End Date
          </label>

          <input
            type="date"
            name="endDate"
            required
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none focus:border-indigo-400"
          >
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Budget
          </label>

          <input
            type="number"
            name="budget"
            min="0"
            placeholder="25000"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          >
        </div>

        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium text-slate-300">
            Notes
          </label>

          <textarea
            name="notes"
            rows="4"
            maxlength="1000"
            placeholder="Anything you want to remember about this trip..."
            class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none placeholder:text-slate-500 focus:border-indigo-400"
          ></textarea>
        </div>

      </div>

      <div class="mt-7 flex gap-3">
        <a
          href="/trips"
          class="rounded-xl border border-white/10 px-5 py-3 text-sm font-medium text-slate-300 transition hover:bg-white/10 hover:text-white"
        >
          Cancel
        </a>

        <button
          type="submit"
          class="rounded-xl bg-indigo-500 px-6 py-3 text-sm font-semibold transition hover:bg-indigo-400"
        >
          Create Trip
        </button>
      </div>

    </form>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>